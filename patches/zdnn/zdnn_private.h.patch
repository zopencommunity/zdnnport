-#include <builtins.h>   // needed for XL C vector ops
-#else                   // If LoZ, use gcc include and typedef
-#include <s390intrin.h> // needed for LoZ vector ops
+// z/OS, XL C and clang alike: <builtins.h> is what brings in the vector
+// intrinsics. Do NOT include <vecintrin.h> directly. It carries no include
+// guard, and under ibm-clang <stdlib.h> already pulls it in through
+// zos_wrappers/builtins.h, so a second include redefines every vec_* function
+// and the translation unit fails to compile.
+#if defined(__MVS__)
+#include <builtins.h>
+#else                   			// If LoZ, use gcc include and typedef
+#include <s390intrin.h> 			// needed for LoZ vector ops
