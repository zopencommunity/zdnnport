         return ZDNN_STATUS(ZDNN_UNAVAILABLE_FUNCTION,
                        "NNPA facility unavailable", NO_ARG);
   }
+#elif defined(__clang__) && defined(__MVS__)
+  // clang on z/OS: detect NNPA with STFLE, then issue the instruction directly.
+  //
+  // invoke_nnpa() is the per-operation hot path and STFLE is serializing, so
+  // cache the answer. z/OS cannot change the facility list under a running
+  // program, which is why the XL C path above reads the static system copy
+  // rather than re-issuing STFLE.
+  static int nnpa_installed = -1;
+  if (nnpa_installed < 0) {
+    nnpa_installed = zdnn_is_nnpa_installed() ? 1 : 0;
+  }
 
-#else
+  if (nnpa_installed) {
     register uint64_t r0 __asm__("%r0") = function_code;
-    register uint64_t r1 __asm__("%r1") = (uint64_t)parm_block;
-
-    __asm__ __volatile__ (
-          "1: .long   0xb93b0000"     "\n\t"   // NNPA
-          "   jo      1b"             "\n\t"   // on CC=3, jump to label '1'
-          "   ipm     %[cc]"          "\n\t"   // fetch cc to cc reg
-          "   srl     %[cc],28"       "\n\t"   // shift
-    : [r0] "+d" (r0), [cc] "+d" (cc)          // ASM outputs
-    : "d" (r1)                           // ASM inputs
-    : "memory", "cc");                   // ASM clobbers
-    rtn.r0 = r0;
+    register uint64_t r1 __asm__("%r1") = (uint64_t)(uintptr_t)parm_block;
+
+    // Two different assemblers see this file: Open XL (ibm-clang64) hands
+    // inline asm to HLASM, while the Open Enterprise SDK clang uses the LLVM
+    // integrated assembler. They share no syntax for raw constants or local
+    // labels -- HLASM rejects ".long"/"jo 1b", LLVM rejects "DC X'..'"/"JO *-4"
+    // -- so use only plain mnemonics here and keep the CC=3 retry in C. NNPA
+    // reports partial completion as CC=3 and resumes from the updated R0, which
+    // is why r0 is an in-out operand.
+    do {
+      __asm__ __volatile__(
+          " nnpa\n"
+          " ipm  %[cc]\n"
+          " srl  %[cc],28\n"
+          : [cc] "=d" (cc), "+d" (r0)
+          : "d" (r1)
+          : "memory", "cc");
+    } while (cc == 3);
 
+    rtn.r0 = r0;
+  } else {
+    return ZDNN_STATUS(ZDNN_UNAVAILABLE_FUNCTION, "NNPA facility unavailable", NO_ARG);
+  }
 #endif   // defined(__MVS__)
   // clang-format on
 
