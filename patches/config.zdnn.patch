diff --git a/config.zdnn b/config.zdnn
index 865a16b..e3369be 100644
--- a/config.zdnn
+++ b/config.zdnn
@@ -53,6 +53,60 @@ case "${target}" in
 	ZDNN_INSTALL_TARGETS="install_libsoname install_static"
 	;;
     *-OS/390)
+	# NOTE: -bkeepfile is an AIX ld option; the z/OS binder rejects it with
+	# IEW2290E. initializer.o is named explicitly on the link line, and
+	# zdnn_init() carries __attribute__((constructor)), so nothing is lost.
+	CC=${CC:-clang}
+	CXX=${CXX:-clang++}
+	LD=${LD:-ibm-clang++64}
+	AR=${AR:-ar}
+	ARFLAGS="${ARFLAGS:--rc}"
+	CLANG_INCLUDE_DIR=$(ibm-clang64 -print-resource-dir 2>/dev/null)/include
+	# Baseline architecture for the library as a whole. Keep this at or below
+	# the consuming application's -march so libzdnn stays loadable on pre-NNPA
+	# hardware: zdnn_init() only issues NNPA-QAF when zdnn_is_nnpa_installed()
+	# says the facility is there, and invoke_nnpa() refuses without it, so a
+	# baseline build simply reports no NNPA and the caller falls back.
+	# convert_hw.c is assembled at a higher arch on its own; see zdnn/Makefile.
+	ZDNN_ARCH="${ZDNN_ARCH:-z15}"
+	# ZOSLIB_HOME is exported by the zoslib zopen dependency; never hardcode it.
+	ZDNN_ZOSLIB_FLAGS=""
+	if test -n "${ZOSLIB_HOME:-}"; then
+		ZDNN_ZOSLIB_FLAGS="-isystem ${ZOSLIB_HOME}/include -include ${ZOSLIB_HOME}/include/zos-v2r5-symbolfixes.h"
+	fi
+	# Enum width is ABI: zdnn_tensor_desc leads with three enum fields, so every
+	# translation unit here and every consumer of zdnn.h must agree. Use the
+	# ibm-clang default (short enums, matching the XL C ABI) instead of forcing
+	# -fno-short-enums onto zdnn_init.c alone.
+	ZDNN_COMMON_CFLAGS="-mzvector -fzvector -Wall -std=gnu11 -fstack-protector-all -fzos-le-char-mode=ascii -mnocsect -m64 -mzos-target=zosv2r5 -march=${ZDNN_ARCH} -mzos-sys-include=/usr/include -D_POSIX_C_SOURCE=200809L ${ZDNN_ZOSLIB_FLAGS}"
+	CFLAGS_INIT="-O3 ${ZDNN_COMMON_CFLAGS} ${CFLAGS_INIT:-}"
+	CFLAGS_QUOTE_INIT="-Wall"
+	CFLAGS_OPT_EXPENSIVE="-funroll-loops"
+	CFLAGS="-O3 ${ZDNN_COMMON_CFLAGS} ${CFLAGS_OPT_EXPENSIVE} ${CFLAGS:-}"
+	CFLAGS_QUOTE="-Wall"
+	CFLAGS_DEBUG="-O0 -g3 ${CFLAGS_DEBUG:-}"
+	CFLAGS_SHARED="-fPIC ${CFLAGS_SHARED:-}"
+	CFLAGS_ASM="-fno-asynchronous-unwind-tables ${CFLAGS_ASM:-}"
+	CFLAGS_NOSEARCH=""
+	CLANG_CXX_DIR=$(ibm-clang64 -print-resource-dir 2>/dev/null)/../../include/c++/v1
+	CXXFLAGS="-O3 -Wall -m64 -mzos-target=zosv2r5 -march=${ZDNN_ARCH} -mzos-sys-include=/usr/include ${CXXFLAGS:-}"
+	CPP_SYMCHECK_FLAGS="-E -mzos-sys-include=/usr/include -o zdnn.i"
+	SODIR="${SODIR:-lib}"
+	LIBNAME="${LIBNAME:-libzdnn}"
+	LIBSONAME="${LIBSONAME:-${LIBNAME}.so.0}"
+	LIBNAME_PRIVATE="${LIBNAME_PRIVATE:-${LIBNAME}-private}"
+	LIBSONAME_PRIVATE="${LIBSONAME_PRIVATE:-${LIBNAME_PRIVATE}.so.0}"
+	LDFLAGS="${LDFLAGS:-}"
+	LDFLAGS_SHARED="-shared -lm ${LDFLAGS_SHARED:-} ${LDFLAGS:-}"
+	LDFLAGS_SHARED_EXPORTALL="-shared -lm ${LDFLAGS_SHARED_EXPORTALL:-} ${LDFLAGS:-}"
+	LDFLAGS_TEST="-L ../zdnn/${SODIR} -l${LIBNAME_PRIVATE#lib} ../zdnn/${SODIR}/${LIBNAME_PRIVATE}.so -lm ${LDFLAGS_TEST:-} ${LDFLAGS:-}"
+	LD_PATH_VAR="${LD_PATH_VAR:-LIBPATH}"
+	ECHOFLAGS=""
+	ZDNN_TMAKE_FILES="t-static t-libsoname t-gccexpo t-symcheck t-listings"
+	ZDNN_MAKE_TARGETS="${SODIR}/${LIBNAME}.a libsoname symcheck"
+	ZDNN_INSTALL_TARGETS="install_libsoname install_static"
+	;;
+    DISABLED-xlc-OS/390)
 	CC=${CC:-xlc}
 	CXX=${CXX:-xlC}
 	LD=${LD:-xlC}
