diff --git a/zdnn/Makefile b/zdnn/Makefile
index a6a214b..3e941a4 100644
--- a/zdnn/Makefile
+++ b/zdnn/Makefile
@@ -44,6 +44,31 @@ $(INIT_OBJFILE): $(INIT_SRCFILE)
 $(OBJDIR)/%.o: %.c
 	$(CC) $(CFLAGS) $(CFLAGS_SHARED) -c $< -o $@
 
+# convert_hw.c and zdnn.c are the only files that name NNPA instructions:
+# VCRNF/VCNF/VCLFNH/VCLFNL/VCFN for the DLFLOAT16 conversions, and nnpa itself.
+# HLASM assembles those at any -march, but the LLVM integrated assembler used by
+# the Open Enterprise SDK clang gates them on arch14 ("instruction requires:
+# nnp-assist"), so these two files need a higher -march than the rest of the
+# library. Everything in them is NNPA-only and unreachable without the facility,
+# so confining the bump here keeps libzdnn loadable on pre-z16 hardware.
+#
+# Both the shared and the static (.nonshared.o, see t-static) variants need the
+# rule, and an explicit rule beats the pattern rule wherever it is defined.
+# Empty by default: an assembler that does not gate on -march needs nothing.
+ZDNN_NNPA_ARCH_FLAGS ?=
+
+$(OBJDIR)/convert_hw.o: convert_hw.c
+	$(CC) $(CFLAGS) $(ZDNN_NNPA_ARCH_FLAGS) $(CFLAGS_SHARED) -c $< -o $@
+
+$(OBJDIR)/zdnn.o: zdnn.c
+	$(CC) $(CFLAGS) $(ZDNN_NNPA_ARCH_FLAGS) $(CFLAGS_SHARED) -c $< -o $@
+
+$(OBJDIR)/convert_hw.nonshared.o: convert_hw.c
+	$(CC) $(CFLAGS) $(ZDNN_NNPA_ARCH_FLAGS) -c $< -o $@
+
+$(OBJDIR)/zdnn.nonshared.o: zdnn.c
+	$(CC) $(CFLAGS) $(ZDNN_NNPA_ARCH_FLAGS) -c $< -o $@
+
 $(OBJDIR)/%.o: %.cpp
 	$(CXX) $(CXXFLAGS) $(CFLAGS_SHARED) -c $< -o $@
 
