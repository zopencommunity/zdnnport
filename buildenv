# bump: zDNN-version /ZDNN_VERSION="(.*)"/ https://github.com/ibm/zdnn.git|semver:*
ZDNN_VERSION="1.1.2"

###
### Build control file for the zDNN port
###

###
### Required Environment Variables
###
export ZOPEN_PROJECT_NAME="zdnn"
export ZOPEN_BUILD_LINE="STABLE"
export ZOPEN_STABLE_URL="https://github.com/ibm/zdnn.git"
export ZOPEN_STABLE_TAG="v${ZDNN_VERSION}"
export ZOPEN_STABLE_DEPS="zoslib make autoconf automake coreutils"
export ZOPEN_DEV_URL=""
export ZOPEN_DEV_DEPS=""
export ZOPEN_CATEGORIES="ai"
export ZOPEN_RUNTIME_DEPS=""
# export ZOPEN_SYSTEM_PREREQ="zos25" # optional system pre-req (default=zos25)


###
### Build settings (Port type: BUILD, Build system: CMake)
###
### Settings for CMake build system
zopen_init() {
	autoreconf -fi
}
export ZOPEN_CONFIGURE="./configure"
export ZOPEN_CONFIGURE_OPTS="--prefix=\${ZOPEN_INSTALL_DIR} CC=ibm-clang64 CXX=ibm-clang++64"
export ZOPEN_MAKE="make"
# config.zdnn derives CFLAGS/CFLAGS_INIT for the *-OS/390 clang target, including
# -O3 and the ZOSLIB_HOME includes. Overriding CFLAGS_INIT on the make line
# replaces it wholesale and only affects zdnn_init.c, so leave it alone.
#
# ZDNN_NNPA_ARCH_FLAGS raises the arch for convert_hw.c alone, which is the only
# file spelling out the arch14 NNPA conversion mnemonics. The rest of the library
# builds at the ZDNN_ARCH baseline (z15) so it stays loadable on pre-z16 machines
# and simply reports no NNPA there.
export ZDNN_NNPA_ARCH="${ZDNN_NNPA_ARCH:-z16}"
export ZOPEN_MAKE_OPTS="all -C zdnn ZDNN_NNPA_ARCH_FLAGS=-march=\${ZDNN_NNPA_ARCH}"
export ZOPEN_MAKE_MINIMAL=Y
export ZOPEN_INSTALL="make"
export ZOPEN_INSTALL_OPTS="install"
export ZOPEN_EXTRA_CFLAGS="-fzvector -mzvector -march=z15 -D_POSIX_C_SOURCE=200809L -mzos-sys-include=/usr/include"
export ZOPEN_EXTRA_CXXFLAGS="-fzvector -mzvector -march=z15 -D_POSIX_C_SOURCE=200809L -mzos-sys-include=/usr/include"
# ZOPEN_CHECK is often 'ctest' or a custom function.
#export ZOPEN_CHECK="ctest"
#export ZOPEN_CHECK_OPTS="--test-dir ../build --output-on-failure"


###
### Required user-supplied functions
###

zopen_check_results() {
  dir="$1"
  pfx="$2"
  chk="$1/$2_check.log"
  # Add logic to extract the test results here:
  echo "actualFailures:0"
  echo "totalTests:1"
  echo "expectedFailures:0"
  echo "expectedTotalTests:1"
}

zopen_get_version() {
  echo "$ZDNN_VERSION"
}


###
### Custom Build Logic (if applicable)
###
# For libraries, this hook exports variables for other ports to use.
zopen_append_to_env() {
  cat <<END
if [ ! -z "\$ZOPEN_IN_ZOPEN_BUILD" ]; then
  export ZOPEN_EXTRA_CFLAGS="\${ZOPEN_EXTRA_CFLAGS} -I\${PWD}/include"
  export ZOPEN_EXTRA_CXXFLAGS="\${ZOPEN_EXTRA_CXXFLAGS} -I\${PWD}/include"
  export ZOPEN_EXTRA_LDFLAGS="\${ZOPEN_EXTRA_LDFLAGS} -L\${PWD}/lib"
  export ZOPEN_EXTRA_LIBS="\${ZOPEN_EXTRA_LIBS} -lzdnn"
fi
END
}

